using Gtk 4.0;
using Adw 1;

template $Options: Adw.Bin {
  child: MenuButton menu_button {
    halign: end;
    valign: center;
    icon-name: "settings-symbolic";
    direction: up;

    popover: PopoverMenu popover {
      flags: nested;

      menu-model: menu {
        section {
          submenu language_menu {
            label: _("_Language");
          }

          submenu subtitles_menu {
            label: _("_Subtitles");
          }
        }

        section {
          item (_("_Repeat"), "win.toggle-loop")
        }

        section {
          label: _("Rotate");
          display-hint: "inline-buttons";

          item {
            custom: "rotate-left";
          }

          item {
            custom: "rotate-right";
          }
        }

        section {
          item {
            custom: "speed";
          }
        }

        section {
          item {
            custom: "brightness";
          }
        }

        section {
          item {
            custom: "saturation";
          }
        }

        section {
          item {
            custom: "";
          }
        }
      };

      [brightness]
      Box {
        margin-top: 9;
        margin-bottom: 9;
        margin-start: 12;
        margin-end: 12;
        spacing: 12;
        orientation: vertical;
        width-request: 240;

        Label {
          halign: start;
          margin-start: 6;
          label: _("Brightness");

          styles [
            "heading",
          ]
        }

        Adw.WrapBox {
          Scale brightness_input {
            value-changed => $_brightness_change();
            orientation: horizontal;
            hexpand: true;
            // Default use max brightness
            adjustment: Gtk.Adjustment {
              lower: 0.0;
              upper: 2.0;
              value: 1.0;
            };

            draw-value: true;
            digits: 2;
            value-pos: right;
          }

          Button {
            icon-name: "object-rotate-left-symbolic";
            tooltip-text: _("Reset Brightness");
            clicked => $_reset_brightness();

            styles [
              "flat",
            ]
          }
        }
      }

      [saturation]
      Box {
        margin-top: 9;
        margin-bottom: 9;
        margin-start: 12;
        margin-end: 12;
        spacing: 12;
        orientation: vertical;
        width-request: 240;

        Label {
          halign: start;
          margin-start: 6;
          label: _("Saturation");

          styles [
            "heading",
          ]
        }

        Adw.WrapBox {
          Scale saturation_input {
            value-changed => $_saturation_change();
            orientation: horizontal;
            hexpand: true;
            // Default use max brightness
            adjustment: Gtk.Adjustment {
              lower: 0.0;
              upper: 2.0;
              value: 1.0;
            };

            draw-value: true;
            digits: 2;
            value-pos: right;
          }

          Button {
            icon-name: "object-rotate-left-symbolic";
            tooltip-text: _("Reset Saturation");
            clicked => $_reset_saturation();

            styles [
              "flat",
            ]
          }
        }
      }

      [speed]
      Box {
        margin-top: 9;
        margin-bottom: 9;
        margin-start: 9;
        margin-end: 9;
        spacing: 12;
        orientation: vertical;

        Label {
          halign: start;
          margin-start: 6;
          label: _("Playback Speed");

          styles [
            "heading",
          ]
        }

        Adw.ToggleGroup {
          homogeneous: true;
          active-name: bind template.rate bidirectional no-sync-create;

          styles [
            "round",
            "flat",
          ]

          Adw.Toggle {
            name: "0.5";
            label: "0.5×";
          }

          Adw.Toggle {
            name: "1.0";
            label: "1.0×";
          }

          Adw.Toggle {
            name: "1.25";
            label: "1.25×";
          }

          Adw.Toggle {
            name: "1.5";
            label: "1.5×";
          }

          Adw.Toggle {
            name: "2.0";
            label: "2.0×";
          }
        }
      }

      [rotate-left]
      Button {
        icon-name: "object-rotate-left-symbolic";
        tooltip-text: _("Rotate Left");
        clicked => $_rotate_left();

        styles [
          "flat",
        ]
      }

      [rotate-right]
      Button {
        icon-name: "object-rotate-right-symbolic";
        tooltip-text: _("Rotate Right");
        clicked => $_rotate_right();

        styles [
          "flat",
        ]
      }
    };

    accessibility {
      label: _("Playback Options");
    }

    ShortcutController {
      scope: managed;

      Shortcut {
        trigger: "<shift>F10";
        action: "activate";
      }
    }

    styles [
      "circular",
      "highlighted",
      "overlaid",
    ]
  };
}
