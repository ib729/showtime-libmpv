using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "General");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Show Shortcuts");
      action-name: "app.shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Open Video");
      action-name: "win.open-video";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Video Options");
      accelerator: "<shift>F10";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Take Screenshot");
      action-name: "win.screenshot";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "New Window");
      action-name: "app.new-window";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Close Window");
      action-name: "win.close-window";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Quit");
      action-name: "app.quit";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Volume");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Increase Volume");
      action-name: "win.increase-volume";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Decrease Volume");
      action-name: "win.decrease-volume";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Mute/Unmute");
      action-name: "win.toggle-mute";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "View");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Toggle Fullscreen");
      action-name: "win.toggle-fullscreen";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Exit Fullscreen");
      accelerator: "Escape";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcuts dialog", "Playback");

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Play/Pause");
      action-name: "win.toggle-playback";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go Back 10 Seconds");
      action-name: "win.backwards";
    }

    Adw.ShortcutsItem {
      title: C_("shortcuts dialog", "Go Forward 10 Seconds");
      action-name: "win.forwards";
    }

    Adw.ShortcutsItem {
      title: _("Decrease Playback Speed");
      action-name: "win.decrease-rate";
    }

    Adw.ShortcutsItem {
      title: _("Increase Playback Speed");
      action-name: "win.increase-rate";
    }
  }
}
