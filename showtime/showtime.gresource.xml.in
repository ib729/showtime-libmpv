<?xml version="1.0" encoding="UTF-8"?>
<gresources>
  <gresource prefix="@PREFIX@/icons/scalable/actions/">
    <file preprocess="xml-stripblanks" alias="settings-symbolic.svg">../data/icons/scalable/actions/settings-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="skip-backwards-10-symbolic.svg">../data/icons/scalable/actions/skip-backwards-10-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="skip-forward-10-symbolic.svg">../data/icons/scalable/actions/skip-forward-10-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="speedometer2.svg">../data/icons/scalable/actions/speedometer2.svg</file>
    <file preprocess="xml-stripblanks" alias="speedometer3.svg">../data/icons/scalable/actions/speedometer3.svg</file>
    <file preprocess="xml-stripblanks" alias="speedometer4.svg">../data/icons/scalable/actions/speedometer4.svg</file>
    <file preprocess="xml-stripblanks" alias="arrow-circular-top-right.svg">../data/icons/scalable/actions/arrow-circular-top-right.svg</file>
  </gresource>
  <gresource prefix="@PREFIX@">
    <file preprocess="xml-stripblanks" alias="gtk/shortcuts-dialog.ui">shortcuts-dialog.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/options.ui">options.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/sound-options.ui">sound-options.ui</file>
    <file preprocess="xml-stripblanks" alias="gtk/window.ui">window.ui</file>
    <file alias="style.css">gtk/style.css</file>
    <file preprocess="xml-stripblanks" alias="@APP_ID@.metainfo.xml">../data/@APP_ID@.metainfo.xml</file>
  </gresource>
</gresources>
